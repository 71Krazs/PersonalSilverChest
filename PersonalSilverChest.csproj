<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PersonalSilverChest</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">$(VALHEIM_MANAGED_DIR)</ValheimManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(BEPINEX_CORE_DIR)</BepInExCoreDir>
    <JotunnDir Condition="'$(JotunnDir)' == ''">$(JOTUNN_DIR)</JotunnDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath></Reference>
    <Reference Include="Jotunn"><HintPath>$(JotunnDir)\Jotunn.dll</HintPath></Reference>
  </ItemGroup>
</Project>
